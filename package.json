{
  "name": "vl-patch-viewer",
  "displayName": "VL Patch Viewer",
  "description": "Interactive VL patch graphs, canvas views, details and saved-value editing / 交互式 VL 节点图、画布视图、详情查看与静态参数编辑。",
  "version": "0.2.0",
  "publisher": "vl-patch-viewer-dev",
  "icon": "images/icon.png",
  "license": "CC-BY-SA-4.0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "vvvv",
    "vl",
    "patch",
    "visual programming",
    "node graph"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/quantumxiaol/vl-patch-viewer.git"
  },
  "bugs": {
    "url": "https://github.com/quantumxiaol/vl-patch-viewer/issues"
  },
  "homepage": "https://github.com/quantumxiaol/vl-patch-viewer#readme",
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "vlPatch.viewer",
        "displayName": "VL Patch Graph",
        "selector": [
          {
            "filenamePattern": "*.vl"
          }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "vlPatch.viewer.validate",
        "title": "VL Patch: Validate with vvvv",
        "enablement": "isWindows"
      },
      {
        "command": "vlPatch.installSkills",
        "title": "VL Patch: Install Agent Skills"
      }
    ],
    "configuration": {
      "title": "VL Patch Viewer",
      "properties": {
        "vlPatch.vvvvcPath": {
          "type": "string",
          "default": "",
          "description": "Full path to vvvvc.exe. Leave empty to auto-detect."
        },
        "vlPatch.nugetPath": {
          "type": "string",
          "default": "",
          "description": "Optional NuGet repository path override passed to vvvvc."
        },
        "vlPatch.validateOnSave": {
          "type": "boolean",
          "default": false,
          "description": "Validate the current VL document with vvvvc after saving (Windows only)."
        },
        "vlPatch.skillInstallDirectory": {
          "type": "string",
          "default": ".agent/skills",
          "description": "Workspace-relative directory where bundled agent skills are installed."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts --max-warnings=0",
    "test": "npm run compile && node --check media/webview.js && mocha \"out/test/**/*.test.js\"",
    "package": "vsce package"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.6"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "@vscode/vsce": "^4.0.0",
    "eslint": "^8.56.0",
    "mocha": "^12.0.3",
    "typescript": "^5.3.3"
  }
}
